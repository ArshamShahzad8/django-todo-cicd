
pipeline {
    agent any

    stages {
        stage('Code Checkout') {
            steps {
                script {
                    git branch: 'develop',
                        url: 'https://github.com/ArshamShahzad8/django-todo-cicd.git'

                    echo "Repository Name: django-todo-cicd"
                    echo "Remote Repository URL: https://github.com/ArshamShahzad8/django-todo-cicd.git"

                    sh '''
                        echo "Current Git Branch:"
                        git branch --show-current

                        echo "Workspace Files and Directories:"
                        ls -la
                    '''
                }
            }
        }

        stage('Build') {
            steps {
                sh 'docker build -t todo .'
            }
        }
    }
}
